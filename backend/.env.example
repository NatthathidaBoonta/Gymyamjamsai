# Backend Environment Variables
# Copy this file to .env and fill in the values

# Server
PORT=5000
NODE_ENV=development

# Frontend URL (for CORS)
FRONTEND_ORIGIN=http://localhost:5173

# Database (MySQL)
# เมื่อรันผ่าน docker-compose ค่า DB_HOST/DB_PORT จะถูก override เป็น mysql:3306 โดยอัตโนมัติ
DB_HOST=gateway01.ap-southeast-1.prod.aws.tidbcloud.com
DB_PORT=4000
DB_USER=gymyam_user
DB_PASSWORD=gymyam_password
DB_NAME=gymyamjamsai

# JWT
JWT_SECRET=changeme-super-secret-key-please-change-in-production
JWT_EXPIRES_IN=24h
