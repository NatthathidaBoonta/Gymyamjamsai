# Production Environment Variables
# IMPORTANT: Copy this to .env and set REAL values before deploying to production
# Never commit the actual .env file with real secrets

# =============================================================================
# DATABASE (Required)
# =============================================================================
# MySQL connection details - use managed database in production (e.g., AWS RDS, Railway MySQL)
MYSQL_ROOT_PASSWORD=<generate-strong-random-password-min-32-chars>
MYSQL_DATABASE=gymyamjamsai_prod
MYSQL_USER=gymuser_prod
MYSQL_PASSWORD=<generate-strong-random-password-min-32-chars>

# =============================================================================
# BACKEND (Backend Container Environment)
# =============================================================================
# Server
PORT=5000
NODE_ENV=production

# Frontend URL (CRITICAL: must match your production domain)
FRONTEND_ORIGIN=https://your-production-domain.com

# Database (Docker will override these, but set for local testing)
DB_CONNECTION=mysql
DB_HOST=mysql_production_host
DB_PORT=3306
DB_NAME=gymyamjamsai_prod
DB_USER=gymuser_prod
DB_PASSWORD=<same-as-MYSQL_PASSWORD-above>

# JWT (CRITICAL SECURITY)
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=<generate-strong-random-hex-string-min-64-chars>
JWT_EXPIRES_IN=24h

# =============================================================================
# FRONTEND (Frontend Environment)
# =============================================================================
# API URL (must match production backend domain/port)
VITE_API_URL=https://api.your-production-domain.com

# =============================================================================
# OPTIONAL: MONITORING & LOGGING
# =============================================================================
# Sentry DSN (for error tracking)
# SENTRY_DSN=https://your-sentry-dsn@sentry.io/project

# Log level (debug, info, warn, error)
# LOG_LEVEL=info

# =============================================================================
# DOCKER COMPOSE PRODUCTION
# =============================================================================
# For docker-compose.prod.yml deployment:
# Copy these values to docker-compose environment sections
# - mysql service: MYSQL_ROOT_PASSWORD, MYSQL_DATABASE, MYSQL_USER, MYSQL_PASSWORD
# - backend service: All BACKEND values above
# - frontend service: All FRONTEND values above

# =============================================================================
# RAILWAY DEPLOYMENT
# =============================================================================
# For Railway.app deployment:
# 1. Create 3 services: MySQL, Backend (Node.js), Frontend (Static)
# 2. Set these env vars in each service's Variables tab
# 3. For MySQL: use Railway's managed MySQL (auto-configured)
# 4. For Backend: add PORT, NODE_ENV, JWT_SECRET, FRONTEND_ORIGIN, DB_* vars
# 5. For Frontend: build with `npm run build`, serve with nginx, set VITE_API_URL
# 6. Connect services via Railway's networking
