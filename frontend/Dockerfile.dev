FROM node:20-alpine

WORKDIR /app

# Copy package files first for Docker layer caching
COPY package*.json ./

# Install dependencies
RUN npm install

# Copy source code (overridden by bind mount in docker-compose for live-reload)
COPY . .

# Expose Vite dev port
EXPOSE 5173

# Run Vite dev server, bind to 0.0.0.0 so it's reachable from outside the container
CMD ["npm", "run", "dev", "--", "--host", "0.0.0.0"]
